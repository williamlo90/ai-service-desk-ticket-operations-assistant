# Copy to .env and supply local values. Do not commit credentials.
# Scoped tokens use https://api.atlassian.com/ex/jira/<JIRA_CLOUD_ID>/rest/api/3/...
# JIRA_SITE_URL is the browser site, not the scoped-token API base.
JIRA_SITE_URL=https://your-test-site.atlassian.net
JIRA_CLOUD_ID=
JIRA_PROJECT_KEY=IT
JIRA_TEST_ISSUE_KEY=IT-1
JIRA_EMAIL=
JIRA_API_TOKEN=
